# Required for model-backed analysis
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Per-role model overrides
SHEETMIND_MODEL_ROUTING_ID=gpt-4o-mini
SHEETMIND_MODEL_QUERY_PLANNING_ID=gpt-4o-mini
SHEETMIND_MODEL_SEMANTIC_TYPING_ID=gpt-4o-mini
SHEETMIND_MODEL_SHEET_SELECTION_ID=gpt-4o-mini
SHEETMIND_MODEL_CODE_GENERATION_ID=gpt-4o
SHEETMIND_MODEL_CODE_REPAIR_ID=gpt-4o
SHEETMIND_MODEL_INSIGHT_WRITING_ID=gpt-4o-mini
SHEETMIND_MODEL_LONG_CONTEXT_ID=gpt-4o

# Server and local state
SHEETMIND_HOST=127.0.0.1
SHEETMIND_PORT=8000
SHEETMIND_DB_PATH=data/sheetmind.db
LOG_LEVEL=INFO
LOG_DIR=logs
# Use 30 for local development and 7 for the public demo.
ANONYMOUS_SESSION_TTL_DAYS=30
SHEETMIND_SESSION_COOKIE_SECURE=false
# One-time local migration aid; never enable this for a public Demo.
SHEETMIND_CLAIM_LEGACY_PROJECTS=false
# Maximum decoded size for each uploaded Excel workbook.
SHEETMIND_MAX_EXCEL_FILE_SIZE_MB=25
# Hard ceiling for one model response. Individual model roles use lower budgets.
SHEETMIND_MAX_MODEL_OUTPUT_TOKENS=2500
